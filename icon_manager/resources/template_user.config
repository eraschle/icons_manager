{
    "template": {
        "code_folders": "Folder names that mark their parent as a code project. They get no icon and are never searched themselves; their parent is searched project_depth levels deep.",
        "exclude_folders": "Folder names that never get an icon and are never searched.",
        "search_folders": [
            "Paths compare icon settings with the subfolder and adds the icons. System variables can be used with %VARIABLE_NAME%",
            {
                "path": "The path of the folder",
                "copy_icon": "Overwrites the value of the if needed. True for copied, otherwise false. Default: None"
            }
        ],
        "icons_path": "Path in which the icons and the associated configurations are saved.",
        "copy_icon": "True if the icons should be copied to the folder, otherwise false. Default: False",
        "project_depth": "How many levels to search inside a folder that contains one of the code_folders. 1: the project and its direct children can get an icon. 0: only the project itself. Default: 1"
    },
    "config": {
        "code_folders": [
            ".github",
            ".git",
            ".idea",
            ".svn",
            ".venv",
            ".vs",
            ".vscode"
        ],
        "exclude_folders": [
            ".py_tests",
            "__pycache__",
            ".mypy_cache",
            "bin",
            "obj",
            "stubs",
            "stubs.min",
            "packages"
        ],
        "search_folders": [
            {
                "path": "C:\\workspace",
                "copy_icon": true
            },
            {
                "path": "C:\\tools",
                "copy_icon": true
            },
            {
                "path": "%OneDriveConsumer%\\workspace",
                "copy_icon": true
            },
            {
                "path": "%OneDriveConsumer%\\Develop",
                "copy_icon": true
            },
            {
                "path": "%OneDriveConsumer%\\Software",
                "copy_icon": true
            },
            {
                "path": "%OneDriveConsumer%\\Links",
                "copy_icon": true
            },
            {
                "path": "%OneDriveConsumer%\\TEMP",
                "copy_icon": true
            },
            {
                "path": "%OneDriveConsumer%\\xBackups",
                "copy_icon": true
            }
        ],
        "icons_path": "%OneDriveConsumer%\\Bilder\\Icons",
        "copy_icon": true,
        "before_or_after": [],
        "project_depth": 1
    }
}